---
const currentYear = new Date().getFullYear();
---

<footer id="contact" class="relative bg-dark border-t border-white/5">
  <!-- Main footer content with hex pattern -->
  <div class="relative overflow-hidden">
    <canvas id="footer-hex" class="absolute inset-0 w-full h-full pointer-events-none"></canvas>

    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 py-16 md:py-20">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8">

        <!-- Brand -->
        <div>
          <img
            src="/assets/images/logo-white.png"
            alt="Team Adrenaline"
            class="h-12 mb-6"
          />
          <p class="text-gray text-sm leading-relaxed max-w-xs">
            Pushing the limits of parkour, gymnastics, and movement since 2011.
          </p>
        </div>

        <!-- Contact details -->
        <div>
          <h3 class="font-['Bebas_Neue',cursive] text-xl tracking-wider text-silver mb-4">Contact</h3>
          <ul class="space-y-3">
            <li>
              <a href="https://goo.gl/maps/9bEs7qJEaM63pd5r7" target="_blank" class="flex items-start gap-3 text-gray hover:text-orange transition-colors text-sm">
                <i class="fa-solid fa-map-pin mt-0.5 text-orange/60"></i>
                <span>Zouk el Kharab - Dbayeh - Beirut, Lebanon</span>
              </a>
            </li>
            <li>
              <a href="tel:+96171044297" class="flex items-center gap-3 text-gray hover:text-orange transition-colors text-sm">
                <i class="fa-solid fa-phone text-orange/60"></i>
                <span>+961 71 044 297</span>
              </a>
            </li>
            <li>
              <a href="mailto:hello@teamadrenaline.me" class="flex items-center gap-3 text-gray hover:text-orange transition-colors text-sm">
                <i class="fa-solid fa-envelope text-orange/60"></i>
                <span>hello@teamadrenaline.me</span>
              </a>
            </li>
            <li>
              <a href="https://wa.me/96171044297" target="_blank" class="flex items-center gap-3 text-gray hover:text-orange transition-colors text-sm">
                <i class="fa-brands fa-whatsapp text-orange/60"></i>
                <span>WhatsApp</span>
              </a>
            </li>
          </ul>
          <p class="mt-4 text-gray/70 text-xs">
            Want to join the team? <a href="mailto:hello@teamadrenaline.me" class="text-orange/80 hover:text-orange transition-colors">Get in touch!</a>
          </p>
        </div>

        <!-- Follow Us -->
        <div>
          <h3 class="font-['Bebas_Neue',cursive] text-xl tracking-wider text-silver mb-4">Follow Us</h3>
          <div class="flex gap-3">
            <a
              href="https://www.facebook.com/teamadrenalinelb/"
              target="_blank"
              class="w-9 h-9 flex items-center justify-center border border-white/10 text-gray hover:text-orange hover:border-orange/40 transition-colors"
              aria-label="Facebook"
            >
              <i class="fa-brands fa-facebook-f text-sm"></i>
            </a>
            <a
              href="https://instagram.com/teamadrenaline"
              target="_blank"
              class="w-9 h-9 flex items-center justify-center border border-white/10 text-gray hover:text-orange hover:border-orange/40 transition-colors"
              aria-label="Instagram"
            >
              <i class="fa-brands fa-instagram text-sm"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar — no hex pattern -->
  <div class="border-t border-white/5 py-6">
    <p class="text-center text-gray/60 text-xs tracking-wider">
      Team Adrenaline &copy; 2011 – {currentYear} All rights reserved
    </p>
  </div>
</footer>

<script>
  const canvas = document.getElementById("footer-hex") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;

  const hexSize = 30;
  const dpr = window.devicePixelRatio || 1;

  function build() {
    const rect = canvas.getBoundingClientRect();
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    ctx.scale(dpr, dpr);

    const width = rect.width;
    const height = rect.height;

    const vertexMap = new Map<string, { x: number; y: number }>();
    const edges: { ax: number; ay: number; bx: number; by: number }[] = [];

    function vKey(x: number, y: number): string {
      return `${Math.round(x * 10)},${Math.round(y * 10)}`;
    }

    function addVertex(x: number, y: number): { x: number; y: number } {
      const k = vKey(x, y);
      if (!vertexMap.has(k)) vertexMap.set(k, { x, y });
      return vertexMap.get(k)!;
    }

    const w = hexSize * 2;
    const h = hexSize * Math.sqrt(3);
    const colStep = w * 0.75;
    const rowStep = h;

    const numCols = Math.ceil(width / colStep) + 3;
    const numRows = Math.ceil(height / rowStep) + 3;

    for (let r = -1; r < numRows; r++) {
      for (let c = -1; c < numCols; c++) {
        const cx = c * colStep;
        const cy = r * rowStep + (c % 2 !== 0 ? rowStep * 0.5 : 0);

        const verts: { x: number; y: number }[] = [];
        for (let i = 0; i < 6; i++) {
          const angle = (Math.PI / 3) * i;
          const vx = cx + hexSize * Math.cos(angle);
          const vy = cy + hexSize * Math.sin(angle);
          verts.push(addVertex(vx, vy));
        }

        for (let i = 0; i < 6; i++) {
          const a = verts[i];
          const b = verts[(i + 1) % 6];
          edges.push({ ax: a.x, ay: a.y, bx: b.x, by: b.y });
        }
      }
    }

    // Draw edges
    ctx.strokeStyle = "rgba(255, 153, 51, 0.08)";
    ctx.lineWidth = 0.5;
    for (const e of edges) {
      ctx.beginPath();
      ctx.moveTo(e.ax, e.ay);
      ctx.lineTo(e.bx, e.by);
      ctx.stroke();
    }

    // Draw vertex dots
    ctx.fillStyle = "rgba(255, 153, 51, 0.1)";
    for (const v of vertexMap.values()) {
      ctx.beginPath();
      ctx.arc(v.x, v.y, 1, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  build();
  window.addEventListener("resize", build);
</script>
