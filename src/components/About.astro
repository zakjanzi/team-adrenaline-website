---
---

<!-- Gradient transition from hero -->
<div class="h-24 bg-gradient-to-b from-dark to-transparent -mb-24 relative z-10"></div>

<section id="about" class="relative bg-dark py-20 md:py-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <!-- Split layout -->
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20">

      <!-- Video side -->
      <div class="about-reveal relative w-full lg:w-1/2 opacity-0">
        <div class="relative aspect-[4/3] overflow-hidden"
          style="clip-path: polygon(0 5%, 100% 0%, 95% 100%, 5% 95%)">
          <video
            src="/assets/video/website-video.mp4"
            autoplay
            loop
            muted
            playsinline
            class="w-full h-full object-cover scale-105"
          ></video>
        </div>
        <!-- Accent line along the clip edge -->
        <div class="absolute -bottom-2 -left-2 w-1/3 h-px bg-orange/40"></div>
        <div class="absolute -top-2 -right-2 w-1/4 h-px bg-gold/30"></div>
      </div>

      <!-- Content side -->
      <div class="w-full lg:w-1/2">
        <h2 class="about-reveal font-['Bebas_Neue',cursive] text-5xl md:text-6xl lg:text-7xl tracking-wider leading-none text-silver mb-6 opacity-0">
          Pushing limits<br />
          <span class="text-orange">since 2011</span>
        </h2>

        <p class="about-reveal text-gray text-base md:text-lg leading-relaxed mb-10 max-w-lg opacity-0">
          Founded by renowned national gymnasts and freerunners, we help you explore your physical limits and find new ways to challenge and improve your body.
        </p>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-6 mb-10">
          <div class="about-reveal opacity-0">
            <span class="block font-['Bebas_Neue',cursive] text-4xl md:text-5xl text-orange">15+</span>
            <span class="text-gray text-xs md:text-sm tracking-widest uppercase">Years</span>
          </div>
          <div class="about-reveal opacity-0">
            <span class="block font-['Bebas_Neue',cursive] text-4xl md:text-5xl text-orange">18</span>
            <span class="text-gray text-xs md:text-sm tracking-widest uppercase">Coaches</span>
          </div>
          <div class="about-reveal opacity-0">
            <span class="block font-['Bebas_Neue',cursive] text-4xl md:text-5xl text-orange">6</span>
            <span class="text-gray text-xs md:text-sm tracking-widest uppercase">Disciplines</span>
          </div>
        </div>

        <!-- CTA -->
        <a
          href="#schedule"
          class="about-reveal inline-flex items-center gap-2 px-8 py-3 bg-orange text-dark font-medium tracking-widest text-sm uppercase hover:bg-gold transition-colors duration-300 opacity-0"
        >
          View Schedule
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .about-reveal.visible {
    animation: aboutFadeUp 0.6s ease-out forwards;
  }

  @keyframes aboutFadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll(".about-reveal").forEach((el, i) => {
    (el as HTMLElement).style.animationDelay = `${i * 0.12}s`;
    observer.observe(el);
  });
</script>
