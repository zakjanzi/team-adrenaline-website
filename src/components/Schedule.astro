---
const disciplines: Record<string, { color: string; border: string }> = {
  gymnastics: { color: "bg-orange/10 text-orange", border: "border-orange/30" },
  parkour: { color: "bg-gold/10 text-gold", border: "border-gold/30" },
  calisthenics: { color: "bg-silver/10 text-silver", border: "border-silver/30" },
  aerials: { color: "bg-orange/10 text-orange", border: "border-orange/20" },
  adrenaline: { color: "bg-gold/10 text-gold", border: "border-gold/20" },
  freestyle: { color: "bg-silver/10 text-silver", border: "border-silver/20" },
};

const schedule = [
  {
    day: "Monday",
    short: "Mon",
    classes: [
      { name: "Gymnastics 1", time: "4PM – 5PM", type: "gymnastics" },
      { name: "Gymnastics 2", time: "5PM – 6PM", type: "gymnastics" },
      { name: "Gymnastics 3", time: "6PM – 7PM", type: "gymnastics" },
      { name: "Gymnastics 4", time: "7PM – 8:30PM", type: "gymnastics" },
      { name: "Calisthenics", time: "8:30PM", type: "calisthenics" },
    ],
  },
  {
    day: "Tuesday",
    short: "Tue",
    classes: [
      { name: "Aerials Beginners", time: "5PM – 6PM", type: "aerials" },
      { name: "Aerials Advanced", time: "6PM – 7PM", type: "aerials" },
      { name: "Aerials Adults", time: "7PM – 8PM", type: "aerials" },
      { name: "Parkour 1", time: "7PM – 8PM", type: "parkour" },
      { name: "Parkour 2", time: "7PM – 8PM", type: "parkour" },
      { name: "Adrenaline Rush", time: "8:30PM", type: "adrenaline" },
    ],
  },
  {
    day: "Wednesday",
    short: "Wed",
    classes: [
      { name: "Parkour 1", time: "6PM – 7PM", type: "parkour" },
      { name: "Parkour 2", time: "7PM – 8PM", type: "parkour" },
      { name: "Calisthenics", time: "8PM", type: "calisthenics" },
    ],
  },
  {
    day: "Thursday",
    short: "Thu",
    classes: [
      { name: "Gymnastics 1", time: "4PM – 5PM", type: "gymnastics" },
      { name: "Gymnastics 2", time: "5PM – 6PM", type: "gymnastics" },
      { name: "Aerials Intermediate", time: "5PM – 6PM", type: "aerials" },
      { name: "Gymnastics 3", time: "5PM – 6PM", type: "gymnastics" },
      { name: "Gymnastics 4", time: "5PM – 6PM", type: "gymnastics" },
      { name: "Adrenaline Rush", time: "8:30PM", type: "adrenaline" },
    ],
  },
  {
    day: "Friday",
    short: "Fri",
    classes: [
      { name: "Gymnastics 1", time: "4PM – 5PM", type: "gymnastics" },
      { name: "Gymnastics 2", time: "5PM – 6PM", type: "gymnastics" },
      { name: "Parkour 1", time: "6PM – 7PM", type: "parkour" },
      { name: "Parkour 2", time: "7PM – 8PM", type: "parkour" },
      { name: "Aerials Beginners", time: "6PM – 7PM", type: "aerials" },
      { name: "Aerials Adults", time: "7PM – 8PM", type: "aerials" },
      { name: "Calisthenics", time: "8PM", type: "calisthenics" },
    ],
  },
  {
    day: "Saturday",
    short: "Sat",
    classes: [
      { name: "Gymnastics 1", time: "9AM – 10AM", type: "gymnastics" },
      { name: "Gymnastics 2-3", time: "10AM – 11AM", type: "gymnastics" },
      { name: "Gymnastics 1", time: "11AM – 12PM", type: "gymnastics" },
      { name: "Freestyle (Open Gym)", time: "6PM – 8PM", type: "freestyle" },
