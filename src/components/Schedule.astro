---

<section id="schedule" class="relative bg-dark py-20 md:py-32">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-12">
      <h2 class="schedule-reveal font-['Bebas_Neue',cursive] text-5xl md:text-6xl tracking-wider text-silver opacity-0">
        Class <span class="text-orange">Schedule</span>
      </h2>
    </div>

    <!-- Discipline filter pills -->
    <div class="schedule-reveal flex flex-wrap justify-center gap-2 mb-8 opacity-0">
      <button class="filter-pill px-3 py-1 text-xs tracking-wider uppercase rounded-full border border-white/10 text-gray cursor-pointer transition-all duration-200" data-filter="all" data-active="true">All</button>
      <button class="filter-pill px-3 py-1 text-xs tracking-wider uppercase rounded-full border border-white/10 text-gray cursor-pointer transition-all duration-200" data-filter="gymnastics">Gymnastics</button>
      <button class="filter-pill px-3 py-1 text-xs tracking-wider uppercase rounded-full border border-white/10 text-gray cursor-pointer transition-all duration-200" data-filter="parkour">Parkour</button>
      <button class="filter-pill px-3 py-1 text-xs tracking-wider uppercase rounded-full border border-white/10 text-gray cursor-pointer transition-all duration-200" data-filter="aerials">Aerials</button>
      <button class="filter-pill px-3 py-1 text-xs tracking-wider uppercase rounded-full border border-white/10 text-gray cursor-pointer transition-all duration-200" data-filter="calisthenics">Calisthenics</button>
      <button class="filter-pill px-3 py-1 text-xs tracking-wider uppercase rounded-full border border-white/10 text-gray cursor-pointer transition-all duration-200" data-filter="adrenaline">Adrenaline Rush</button>
    </div>

    <!-- Day tabs -->
    <div class="schedule-reveal flex justify-center mb-10 opacity-0">
      <div class="inline-flex flex-wrap justify-center gap-1 bg-white/5 p-1 rounded-sm">
        {schedule.map((day, i) => (
          <button
            class:list={[
              "day-tab px-4 py-2 text-sm tracking-widest uppercase transition-all duration-200 cursor-pointer",
              i === 0 ? "bg-orange text-dark" : "text-gray hover:text-silver hover:bg-white/10",
            ]}
            data-day={i}
          >
            <span class="hidden sm:inline">{day.day}</span>
            <span class="sm:hidden">{day.short}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Day panels -->
    {schedule.map((day, dayIndex) => (
      <div
        class:list={["day-panel", dayIndex === 0 ? "" : "hidden"]}
        data-panel={dayIndex}
      >
        <div class="grid gap-3">
          {day.classes.map((cls) => {
            const d = disciplines[cls.type];
            return (
              <div class={`schedule-card flex items-center justify-between p-4 border ${d.border} rounded-sm bg-white/[0.02] hover:bg-white/[0.05]`} data-type={cls.type}>
                <div class="flex items-center gap-4">
                  <span class={`inline-block px-3 py-1 text-xs tracking-wider uppercase rounded-sm ${d.color}`}>
                    {cls.type}
                  </span>
                  <span class="text-silver text-sm md:text-base">{cls.name}</span>
                </div>
                <span class="text-gray text-sm">{cls.time}</span>
              </div>
            );
          })}
        </div>
        <p class="no-classes-msg hidden text-center text-gray text-sm py-8">Try another dayPerfec</p>
      </div>
    ))}

    <!-- CTA area -->
    <div class="schedule-reveal mt-12 flex flex-col items-center gap-8 opacity-0">
      <a
        href="https://wa.me/96171044297"
        target="_blank"
        class="inline-flex items-center gap-3 px-10 py-4 bg-orange text-dark font-medium tracking-widest text-sm uppercase hover:bg-gold transition-colors duration-300"
      >
        <i class="fa-brands fa-whatsapp text-lg"></i>
        Start Training
      </a>
      <p class="text-gray text-sm">
        Private sessions available upon request.
      </p>
    </div>
  </div>
</section>

<style>
  .schedule-reveal.visible {
    animation: scheduleFadeUp 0.6s ease-out forwards;
  }

  .schedule-card {
    transition: all 0.3s ease;
  }

  .schedule-card.filtered-out {
    display: none;
  }

  .filter-pill[data-active="true"] {
    border-color: rgba(255, 153, 51, 0.3);
    color: #ff9933;
    background-color: rgba(255, 153, 51, 0.1);
  }

  @keyframes scheduleFadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

</style>

<script>
  // Scroll reveal
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll(".schedule-reveal").forEach((el, i) => {
    (el as HTMLElement).style.animationDelay = `${i * 0.12}s`;
    observer.observe(el);
  });

  // Discipline filtering
  const filterPills = document.querySelectorAll(".filter-pill");

  function applyFilter(filter: string) {
    // Apply to all panels (visible and hidden)
    document.querySelectorAll(".day-panel").forEach((panel) => {
      let visibleCount = 0;
      panel.querySelectorAll(".schedule-card").forEach((card) => {
        const type = card.getAttribute("data-type");
        if (filter === "all" || type === filter) {
          card.classList.remove("filtered-out");
          visibleCount++;
        } else {
          card.classList.add("filtered-out");
        }
      });

      const msg = panel.querySelector(".no-classes-msg");
      if (msg) {
        if (visibleCount === 0) {
          msg.classList.remove("hidden");
        } else {
          msg.classList.add("hidden");
        }
      }
    });
  }

  filterPills.forEach((pill) => {
    pill.addEventListener("click", () => {
      filterPills.forEach((p) => p.removeAttribute("data-active"));
      pill.setAttribute("data-active", "true");

      const filter = pill.getAttribute("data-filter") || "all";
      applyFilter(filter);
    });
  });

  // Tab switching
  const tabs = document.querySelectorAll(".day-tab");
  const panels = document.querySelectorAll(".day-panel");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const day = tab.getAttribute("data-day");

      tabs.forEach((t) => {
        t.classList.remove("bg-orange", "text-dark");
        t.classList.add("text-gray", "hover:text-silver", "hover:bg-white/10");
      });
      tab.classList.add("bg-orange", "text-dark");
      tab.classList.remove("text-gray", "hover:text-silver", "hover:bg-white/10");

      panels.forEach((p) => p.classList.add("hidden"));
      document.querySelector(`[data-panel="${day}"]`)?.classList.remove("hidden");

      // Re-apply active filter
      const activeFilter = document.querySelector(".filter-pill.active")?.getAttribute("data-filter") || "all";
      applyFilter(activeFilter);
    });
  });
</script>
